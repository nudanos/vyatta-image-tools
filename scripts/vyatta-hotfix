use strict;
use warnings;

use Sys::Syslog;
use File::Basename;
use IPC::Run3;

use lib "/opt/vyatta/share/perl5/";
use Vyatta::Configd;
use Vyatta::Live;

# Each package path is printed and the problem with it, if any; false if
# any of them has one. A path is passed on in a space-separated list, so it
# is held to the characters of a package name.
sub packages_valid {
    my @pkgs  = @_;
    my $valid = 1;
    foreach my $path (@pkgs) {
        my $file = basename($path);
        if ( $path !~ m{^[A-Za-z0-9._+/~-]+$}x ) {
            print "Invalid package name: [$file]\n";
            $valid = 0;
        }
        if ( !-f $path ) {
            print "Selected file does not exist: $path\n";
            $valid = 0;
        }
        if ( $file !~ m/[.]deb$/x ) {
            print "Selected file is not a debian package: $path\n";
            $valid = 0;
        }
    }
    return $valid;
}

exit 1 unless defined $ARGV[0];
die "Argument contains unsanitary characters, stopped\n"
  if ( $ARGV[0] =~ m{[^-A-Za-z0-9_/.~+]}x );
my $target_image = "$ARGV[0]";

my $client = Vyatta::Configd::Client->new();
exit 1 unless defined $client;

my $tree = $client->tree_get_full_hash("system-image");
exit 1 unless defined $tree->{'system-image'}->{'installed-images'};
exit 1 unless defined $tree->{'system-image'}->{'running-image'};

my $running_image = $tree->{'system-image'}->{'running-image'};
if ( $running_image eq $target_image ) {
    print "Cannot install packages to current image!\n";
    exit 1;
}

my $images = $tree->{'system-image'}->{'installed-images'};
my $clone  = "${target_image}." . rand();

# Lookup target image
my $found = 0;
foreach my $image ( @{$images} ) {
    if ( $image->{'name'} eq $target_image ) {
        $found = 1;
    }
}
if ( $found == 0 ) {
    print "Selected image $target_image, does not exist\n";
    exit 1;
}

my @pkgs = @ARGV[ 2 .. $#ARGV ];
if ( scalar @pkgs == 0 ) {
    exit 1;
}
exit 1 unless packages_valid(@pkgs);

local $ENV{'VYATTA_NEW_PKGS'} = join " ", @pkgs;
if ( scalar @pkgs > 1 ) {
    print "Installing " . scalar @pkgs . " new packages\n";
}
else {
    print "Installing 1 new package\n";
}

print "Packages: $ENV{'VYATTA_NEW_PKGS'}\n";

# Create backup of target image
syslog( 'info', "Creating clone ($clone) of target image to perform package upgrade on..." );
system( 'clone-image.pl', '--old_name', $target_image, '--new_name', $clone );
my $ret = $? >> 8;
if ( $ret != 0 ) {
    syslog( 'err', "Failed to create clone." );
    print "Failed to create clone \n";
    print "The original target image was left untouched.\n";
    exit 1;
}

# Install new packages
syslog( 'info', "Installing new packages to target image [$target_image]" );
syslog( 'info', "Packages: $ENV{'VYATTA_NEW_PKGS'}" );
my $chroot_out = '';
run3( [ 'vyatta-squashfs-chroot', $clone, 'INSTALL' ], \undef, \$chroot_out );
print $chroot_out;
$ret = $? >> 8;
if ( $ret != 0 ) {
    syslog( 'err', "Failed to install new packages. Removing cloned image ($clone)" );
    print "Failed to install new packages to target image: $target_image.\n";
    print "The original target image was left untouched.\n";
    delete_image($clone);
    exit 1;
}
else {
    syslog( 'info',
        "Package install successful. Replacing cloned image ($clone) with target ($target_image)" );
    delete_image($target_image);

    # quietly, and before reporting success: run by /bin/sh (dash), the
    # old "&>/dev/null" put the rename in the background instead
    run3( [ 'rename-image.pl', '--old_name', $clone, '--new_name', $target_image ],
        \undef, \undef, \undef );
    syslog( 'info', "Successfully installed new packages to target image: [$target_image]." );
    print "Done.\n";
}
