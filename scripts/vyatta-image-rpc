use warnings;
use strict;

use Getopt::Long;
use File::Basename;
use IPC::Run3;
use JSON;

use lib "/opt/vyatta/share/perl5";
use Vyatta::Live;

my $sbindir = $ENV{vyatta_sbindir} // '/opt/vyatta/sbin';

# The RPC's input, as configd passes it on standard input
sub rpc_input {
    my $in = do { local $/ = undef; <> };    ## no critic (InputOutput::ProhibitExplicitStdin) reason: configd's RPC input
    return decode_json($in);
}

# the location is an argument of the installer, never shell text: this runs
# as root with what the RPC was given
sub add_image {
    my $input    = rpc_input();
    my $location = $input->{'location'};

    local $ENV{VY_ADD_IMG_USER} = $input->{'username'};
    local $ENV{VY_ADD_IMG_PASS} = $input->{'password'};

    my $output = '';
    run3( [ "$sbindir/vyatta-install-image", '-y', $location ], \undef, \$output, \undef );

    # the installer's own account of what went wrong is the RPC's error
    die $output if $? != 0;    ## no critic (ErrorHandling::RequireCarping) reason: the installer's message, not a location in this script

    print encode_json( {} );
    return;
}

sub delete_image_rpc {
    my $name = rpc_input()->{'name'};

    delete_image($name);

    print encode_json( {} );
    return;
}

sub set_default_boot_image_rpc {
    my $name = rpc_input()->{'name'};

    set_default_boot_image($name);

    print encode_json( {} );
    return;
}

sub get_state {
    my $get_image_state = sub {
        my ($image) = @_;
        my $output = {
            'name'    => $image,
            'version' => get_image_version($image),
            'storage' => get_image_storage($image),
        };
        return $output;
    };

    my @images = map { $get_image_state->($_) } list_images();

    my $output = {
        'installed-images'   => \@images,
        'running-image'      => get_running_image(),
        'default-boot-image' => get_default_boot_image(),
    };

    print encode_json($output);
    return;
}

sub call_action_by_name {
    my ( $actions, $script_name, $opt_name, $usage ) = @_;

    my $usagefn = sub {
        printf( "Usage for %s %s:\n", $script_name, $usage );
        printf( "    %s %s --%s=[%s]\n",
            $script_name, $usage, $opt_name, join( "|", keys( %{$actions} ) ) );
        exit(1);
    };

    my ($name);
    GetOptions( "$opt_name=s" => \$name, ) or $usagefn->();
    $usagefn->() unless ( defined($name) );

    my $action = $actions->{$name};
    $usagefn->() unless ( defined($action) );

    return $action->();
}

my %actions = (
    "add-image"              => \&add_image,
    "delete-image"           => \&delete_image_rpc,
    "set-default-boot-image" => \&set_default_boot_image_rpc,
    "get-state"              => \&get_state,
);
call_action_by_name( \%actions, basename($0), "action", "" );
